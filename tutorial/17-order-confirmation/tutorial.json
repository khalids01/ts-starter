{
  "id": "order-confirmation",
  "title": "Confirm an order and commit its stock",
  "mode": "walkthrough",
  "prerequisites": [
    "An eligible pending order with a valid inventory reservation."
  ],
  "scenes": [
    {
      "id": "01",
      "title": "Find the workflow",
      "narration": "Confirmation accepts the order for fulfilment and commits its reserved inventory. Open the pending order and review the customer, line items, totals and reservation first. Confirm only when the order is ready for your team to handle.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{orderId}}"
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Line items"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Customer"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Totals"
          }
        }
      ]
    },
    {
      "id": "02",
      "title": "Understand the controls",
      "narration": "Use Order status to choose Confirmed. Review the pending change and select Update order. Wait for the success state instead of clicking repeatedly. A reservation that is no longer valid may require investigation before confirmation can succeed.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{orderId}}"
        },
        {
          "kind": "select",
          "target": {
            "css": "div:has(> div > p:text-is(\"Order status\")) > button[role=\"combobox\"]"
          },
          "option": "Confirmed"
        },
        {
          "kind": "show",
          "target": {
            "css": "div:has(> div > p:text-is(\"Order status\")) > button[role=\"combobox\"]"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "button",
            "name": "Update order"
          }
        },
        {
          "kind": "show",
          "target": {
            "css": "div:has(> div > p:text-is(\"Order status\")) > button[role=\"combobox\"]"
          }
        }
      ]
    },
    {
      "id": "03",
      "title": "Perform the task",
      "narration": "After confirmation, verify the order status and inventory status together. Inventory should show the committed state for the accepted goods. Confirmation does not collect payment and does not prove that a parcel has been shipped.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{confirmedOrderId}}"
        },
        {
          "kind": "show",
          "target": {
            "css": "div:has(> div > p:text-is(\"Order status\")) > button[role=\"combobox\"]"
          }
        },
        {
          "kind": "show",
          "target": {
            "css": "p:text-is(\"Inventory\")"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Payment evidence"
          }
        }
      ]
    },
    {
      "id": "04",
      "title": "Verify and continue",
      "narration": "Continue with payment evidence and the correct fulfilment controls. Use cancellation and physical recovery workflows if circumstances change. Do not use a status change as a substitute for releasing or recovering stock correctly.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{confirmedOrderId}}"
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Payment evidence"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Physical inventory recovery"
          }
        }
      ]
    }
  ]
}
