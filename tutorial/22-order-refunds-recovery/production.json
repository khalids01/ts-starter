  "notes": [
    "Capture only settled production-build frames at 1440 x 900; do not film navigation or loading.",
    "Each frame holds its one spotlight for the entire measured narration section, followed by 0.2 seconds of silence.",
    "Walkthrough frames explain controls. They do not establish that an unsubmitted operation succeeded.",
    "Prepare fictional marker-owned fixtures with the states specified in the recording checklist; capture refuses missing, ambiguous or ineligible controls.",
    "Audio, capture, full playback review and upload require separate authorization. No batch production or live provider actions.",
    "After-operation frames are separately prepared, API-checked fictional examples and carry a visible example label. This walkthrough never performs those state transitions."
  ],
  "segments": [
    {
      "id": "01",
      "scene": "01",
      "text": "A refund records money returned, while inventory recovery records what happened to the goods.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{orderId}}"
        }
      ],
      "target": {
        "role": "heading",
        "name": "Cancellation and refunds"
      },
      "evidence": "controls",
      "checks": [
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "paymentStatus",
          "equals": "paid"
        }
      ]
    },
    {
      "id": "02",
      "scene": "01",
      "text": "Open the order and inspect Cancellation and refunds together with Physical inventory recovery. Neither event should be assumed from the other.",
      "actions": [],
      "target": {
        "role": "heading",
        "name": "Physical inventory recovery"
      },
      "evidence": "controls",
      "checks": [
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "paymentStatus",
          "equals": "paid"
        }
      ]
    },
    {
      "id": "03",
      "scene": "02",
      "text": "Use Record manual refund only for a real refund you can support with evidence.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{orderId}}"
        },
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Record refund"
          }
        }
      ],
      "target": {
        "role": "dialog",
        "name": "Record manual refund"
      },
      "evidence": "controls",
      "checks": [
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "paymentStatus",
          "equals": "paid"
        }
      ]
    },
    {
      "id": "04",
      "scene": "02",
      "text": "Enter the amount and reason, and read the restock choice carefully. Partial refunds must reflect the actual money returned, not an arbitrary adjustment to the total.",
      "actions": [],
      "target": {
        "css": "#refund-amount",
        "dialog": "Record manual refund"
      },
      "evidence": "controls",
      "checks": [
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "paymentStatus",
          "equals": "paid"
        }
      ]
    },
    {
      "id": "05",
      "scene": "03",
      "text": "For goods returned after dispatch, record physical receipt first. Inspect every returned item and choose its condition. Unsafe or unsellable goods must not be made available merely because a customer was refunded.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{returnedOrderId}}"
        }
      ],
      "target": {
        "role": "heading",
        "name": "Physical inventory recovery"
      },
      "evidence": "persisted-example",
      "frameLabel": "Returned goods awaiting inspection",
      "checks": [
        {
          "path": "/admin/orders/{{returnedOrderId}}",
          "field": "inventoryStatus",
          "equals": "committed"
        },
        {
          "path": "/admin/orders/{{returnedOrderId}}",
          "field": "recovery.disposition",
          "equals": "awaiting_inspection"
        }
      ]
    },
    {
      "id": "06",
      "scene": "04",
      "text": "Restock only when the recovery controls confirm eligibility and every required inspection is complete.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{recoveredOrderId}}"
        }
      ],
      "target": {
        "role": "heading",
        "name": "Physical inventory recovery"
      },
      "evidence": "persisted-example",
      "frameLabel": "Inspected and restocked example",
      "checks": [
        {
          "path": "/admin/orders/{{recoveredOrderId}}",
          "field": "inventoryStatus",
          "equals": "restocked"
        },
        {
          "path": "/admin/orders/{{recoveredOrderId}}",
          "field": "recovery.disposition",
          "equals": "sellable"
        }
      ]
    },
    {
      "id": "07",
      "scene": "04",
      "text": "Review payment totals, timeline and inventory history afterward.",
      "actions": [],
      "target": {
        "role": "heading",
        "name": "Timeline"
