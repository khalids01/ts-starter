    },
    {
      "path": "/admin/orders/{{recoveredOrderId}}",
      "field": "customerName",
      "equals": "tutorial-order-refunds-recovery-recoveredOrder"
    },
    {
      "path": "/admin/orders/{{returnedOrderId}}",
      "field": "customerName",
      "equals": "tutorial-order-refunds-recovery-returnedOrder"
    }
  ],
  "outcomeChecks": [],
  "cleanup": []
}
