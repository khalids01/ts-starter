  "segments": [
    {
      "id": "01",
      "scene": "01",
      "text": "Brands identify who makes or owns a product. Open Catalog, then Brands. Use accurate brand names and owned or approved logo images. A brand is a catalog record; it does not change the deployment brand or the shop itself.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/catalog"
        },
        {
          "kind": "click",
          "target": {
            "role": "tab",
            "name": "Brands"
          }
        }
      ],
      "target": {
        "role": "tab",
        "name": "Brands"
      },
      "evidence": "controls"
    },
    {
      "id": "02",
      "scene": "02",
      "text": "Select Brand.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/catalog"
        },
        {
          "kind": "click",
          "target": {
            "role": "tab",
            "name": "Brands"
          }
        },
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Brand"
          }
        }
      ],
      "target": {
        "role": "dialog",
        "name": "Create brand"
      },
      "evidence": "controls"
    },
    {
      "id": "03",
      "scene": "02",
      "text": "Enter its name and slug.",
      "actions": [],
      "target": {
        "field": "Name",
        "dialog": "Create brand"
      },
      "evidence": "controls"
    },
    {
      "id": "04",
      "scene": "02",
      "text": "You can add a logo, website URL and description when those details are known.",
      "actions": [],
      "target": {
        "field": "Website URL",
        "dialog": "Create brand"
      },
      "evidence": "controls"
    },
    {
      "id": "05",
      "scene": "02",
      "text": "Active and featured control the record state and presentation.",
      "actions": [],
      "target": {
        "css": "label:has-text(\"Active\")",
        "dialog": "Create brand"
      },
      "evidence": "controls"
    },
    {
      "id": "06",
      "scene": "02",
      "text": "Leave optional facts empty rather than inventing them.",
      "actions": [],
      "target": {
        "field": "Website URL",
        "dialog": "Create brand"
      },
      "evidence": "controls"
    },
    {
      "id": "07",
      "scene": "03",
      "text": "Save the brand and check that it appears in the list. When editing a product, its category brand policy decides whether a brand is optional, required or unavailable. Selecting a brand does not create inventory or activate the product.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/catalog"
        },
        {
          "kind": "click",
          "target": {
            "role": "tab",
            "name": "Brands"
          }
        },
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Brand"
          }
        },
        {
          "kind": "fill",
          "target": {
            "field": "Name"
          },
          "value": "{{brandName}}"
        },
        {
          "kind": "fill",
          "target": {
            "field": "Slug"
          },
          "value": "{{brandSlug}}"
        },
        {
          "kind": "submit",
          "target": {
            "role": "button",
            "name": "Save"
          },
          "capture": {
            "key": "brandId",
            "responsePath": "/admin/catalog/brands",
            "field": "id"
          }
        },
        {
          "kind": "goto",
          "path": "/admin/catalog"
        },
        {
          "kind": "click",
          "target": {
            "role": "tab",
            "name": "Brands"
          }
        }
      ],
      "target": {
        "text": "{{brandName}}"
      },
      "evidence": "persisted-result",
      "checks": [
        {
          "path": "/admin/catalog/brands?search={{brandName}}&limit=100",
          "field": "items.0.name",
          "equals": "{{brandName}}"
        },
        {
          "path": "/admin/catalog/brands?search={{brandName}}&limit=100",
          "field": "items.0.id",
          "equals": "{{brandId}}"
        }
      ]
    },
    {
