          "kind": "goto",
          "path": "/admin/catalog"
        },
        {
          "kind": "click",
          "target": {
            "role": "tab",
            "name": "Brands"
          }
        }
      ],
      "target": {
        "role": "tab",
        "name": "Brands"
      },
      "evidence": "controls"
    },
    {
