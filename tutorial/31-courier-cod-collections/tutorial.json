{
  "id": "courier-cod-collections",
  "title": "Record courier COD collection evidence",
  "mode": "walkthrough",
  "prerequisites": [
    "A simulated booked COD consignment and fictional gross collection evidence."
  ],
  "scenes": [
    {
      "id": "01",
      "title": "Find the workflow",
      "narration": "COD collection evidence concerns money collected from the customer by the courier. Open COD payouts. Distinguish booked COD, gross customer collection, courier fees and net payout: these values are related but they are not interchangeable.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/couriers/cod-payouts"
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "COD collections"
          }
        }
      ]
    },
    {
      "id": "02",
      "title": "Understand the controls",
      "narration": "Find the intended consignment or collection record. Verify the provider reference, currency and gross amount collected. Enter the collection reference and a factual evidence note through the supported controls.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/couriers/shipments"
        },
        {
          "kind": "click",
          "target": {
            "css": "[data-slot=\"card\"]:has([data-slot=\"card-title\"]:text-is(\"{{shipmentReference}}\")) button:text-is(\"Record settlement\")"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "dialog",
            "name": "Record gross COD collection evidence"
          }
        },
        {
          "kind": "show",
          "target": {
            "field": "Amount",
            "dialog": "Record gross COD collection evidence"
          }
        },
        {
          "kind": "show",
          "target": {
            "field": "Collection/reference ID",
            "dialog": "Record gross COD collection evidence"
          }
        }
      ]
    },
    {
      "id": "03",
      "title": "Perform the task",
      "narration": "Record only evidence you actually have. A net bank payout after fees is not the same as gross customer collection. Review mismatches instead of inventing a manual payment to make the customer order appear fully paid.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/couriers/shipments"
        },
        {
          "kind": "click",
          "target": {
            "css": "[data-slot=\"card\"]:has([data-slot=\"card-title\"]:text-is(\"{{shipmentReference}}\")) button:text-is(\"Record settlement\")"
          }
        },
        {
          "kind": "show",
          "target": {
            "field": "Evidence note",
            "dialog": "Record gross COD collection evidence"
          }
        },
        {
          "kind": "show",
          "target": {
            "field": "Amount",
            "dialog": "Record gross COD collection evidence"
          }
        },
        {
          "kind": "show",
          "target": {
            "field": "Evidence note",
            "dialog": "Record gross COD collection evidence"
          }
        }
      ]
    },
    {
      "id": "04",
      "title": "Verify and continue",
      "narration": "Check the order payment totals and collection history after reconciliation. Keep fees and payout evidence distinct. This demonstration uses fictional simulator records; it does not request or confirm a real provider payout.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/couriers/cod-payouts"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{orderId}}"
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Payment evidence"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Totals"
          }
        },
        {
          "kind": "show",
          "target": {
            "role": "heading",
            "name": "Timeline"
          }
        }
      ]
    }
  ]
}
