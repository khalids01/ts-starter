  "notes": [
    "Capture only settled production-build frames at 1440 x 900; do not film navigation or loading.",
    "Each frame holds its one spotlight for the entire measured narration section, followed by 0.2 seconds of silence.",
    "Walkthrough frames explain controls. They do not establish that an unsubmitted operation succeeded.",
    "Prepare fictional marker-owned fixtures with the states specified in the recording checklist; capture refuses missing, ambiguous or ineligible controls.",
    "Audio, capture, full playback review and upload require separate authorization. No batch production or live provider actions.",
    "After-operation frames are separately prepared, API-checked fictional examples and carry a visible example label. This walkthrough never performs those state transitions."
  ],
  "segments": [
    {
      "id": "01",
      "scene": "01",
      "text": "Delivery and completion record different milestones. Open the shipped order and verify delivery evidence from the actual handoff. Use Mark delivered only after delivery is confirmed; a tracking number by itself is not proof.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{orderId}}"
        }
      ],
      "target": {
        "role": "heading",
        "name": "Fulfillment"
      },
      "evidence": "controls",
      "checks": [
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "deliveryStatus",
          "equals": "shipped"
        },
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "inventoryStatus",
          "equals": "committed"
        }
      ]
    },
    {
      "id": "02",
      "scene": "02",
      "text": "Select Mark delivered and record a factual note.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{orderId}}"
        },
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Mark delivered"
          }
        }
      ],
      "target": {
        "field": "Note",
        "dialog": "Mark order delivered"
      },
      "evidence": "controls",
      "checks": [
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "deliveryStatus",
          "equals": "shipped"
        },
        {
          "path": "/admin/orders/{{orderId}}",
          "field": "inventoryStatus",
          "equals": "committed"
        }
      ]
    },
    {
      "id": "03",
      "scene": "02",
      "text": "Wait for the saved state, then check delivery status and timestamp. If a courier integration supplies delivery information, review its evidence and supported controls before adding a conflicting manual action.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/orders/{{deliveredOrderId}}"
        }
      ],
      "target": {
        "css": "section:has(> h2:text-is(\"Fulfillment\"))"
      },
      "evidence": "persisted-example",
      "checks": [
        {
          "path": "/admin/orders/{{deliveredOrderId}}",
          "field": "deliveryStatus",
          "equals": "delivered"
        },
        {
          "path": "/admin/orders/{{deliveredOrderId}}",
          "field": "inventoryStatus",
          "equals": "committed"
        }
      ],
      "frameLabel": "Saved delivery evidence example"
    },
    {
      "id": "04",
      "scene": "03",
      "text": "Check that payment is fully collected, delivery is delivered, inventory remains committed and no operational issue blocks completion.",
