        {
          "kind": "goto",
          "path": "/admin/orders"
        },
        {
          "kind": "goto",
          "path": "/admin/orders/{{deliveredOrderId}}"
        }
      ],
      "target": {
        "role": "heading",
        "name": "Totals"
      },
      "evidence": "persisted-example",
      "frameLabel": "Delivered and paid example",
      "checks": [
        {
          "path": "/admin/orders/{{deliveredOrderId}}",
          "field": "deliveryStatus",
          "equals": "delivered"
        },
        {
          "path": "/admin/orders/{{deliveredOrderId}}",
          "field": "paymentStatus",
          "equals": "paid"
        },
        {
          "path": "/admin/orders/{{deliveredOrderId}}",
          "field": "inventoryStatus",
          "equals": "committed"
        },
        {
          "path": "/admin/orders/{{deliveredOrderId}}",
          "field": "orderStatus",
          "equals": "confirmed"
        }
      ]
    },
