{
  "marker": "tutorial-catalog-categories",
  "values": {
    "categoryName": "tutorial-catalog-categories-demo",
    "categorySlug": "tutorial-catalog-categories-clothing"
  },
  "ownershipChecks": [],
  "outcomeChecks": [
    {
      "path": "/admin/catalog/categories/{{categoryId}}",
      "field": "name",
      "equals": "{{categoryName}}"
    }
  ],
  "cleanup": [
    {
      "method": "POST",
      "path": "/admin/catalog/lifecycle/category/{{categoryId}}/archive",
      "verify": [
        {
          "path": "/admin/catalog/categories/{{categoryId}}",
          "field": "name",
          "equals": "{{categoryName}}"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/admin/catalog/lifecycle/category/{{categoryId}}/delete",
      "verify": [
        {
          "path": "/admin/catalog/lifecycle/category?limit=100",
          "field": "items",
          "find": {
            "field": "id",
            "equals": "{{categoryId}}"
          },
          "property": "name",
          "equals": "{{categoryName}}"
        }
      ]
    }
  ]
}
