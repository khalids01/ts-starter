  "segments": [
    {
      "id": "01",
      "scene": "01",
      "text": "Attributes describe product details and selectable options. Open Catalog, then Attributes. Reuse a well-defined field instead of creating several fields that mean the same thing. The category template decides where and how the field is used.",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/catalog"
        },
        {
          "kind": "click",
          "target": {
            "role": "tab",
            "name": "Attributes"
          }
        }
      ],
      "target": {
        "role": "tab",
        "name": "Attributes"
      },
      "evidence": "controls"
    },
    {
      "id": "02",
      "scene": "02",
      "text": "Select Attribute",
      "actions": [
        {
          "kind": "goto",
          "path": "/admin/catalog"
        },
        {
          "kind": "click",
          "target": {
            "role": "tab",
            "name": "Attributes"
          }
        },
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Attribute"
          }
        }
      ],
      "target": {
        "role": "dialog",
        "name": "Create attribute"
      },
      "evidence": "controls"
    },
    {
      "id": "03",
      "scene": "02",
      "text": "and enter a name,",
      "actions": [
