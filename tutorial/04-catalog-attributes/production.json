    {
      "id": "10",
      "scene": "03",
      "text": "Product details, variant options and inventory fields serve different purposes. A size option for a SKU is different from a descriptive specification.",
      "actions": [
        {
          "kind": "key",
          "key": "Escape"
        }
      ],
      "target": {
        "text": "{{attributeName}}"
      },
      "evidence": "controls"
    },
    {
      "id": "11",
      "scene": "04",
      "text": "Open a prepared product to check the resulting fields. Required values must be present before readiness validation succeeds. Review existing category templates before removing values or making fields required; historical product data must remain understandable.",
