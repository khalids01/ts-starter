        "field": "Type",
        "dialog": "Create attribute"
      },
      "evidence": "controls"
    },
    {
      "id": "06",
      "scene": "02",
      "text": "Choose a type that matches the information: text, number or a supported choice type.",
      "actions": [],
      "target": {
        "field": "Type",
        "dialog": "Create attribute"
      },
      "evidence": "controls"
    },
    {
      "id": "07",
      "scene": "02",
      "text": "Assign relevant categories",
