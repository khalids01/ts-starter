{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {"title": "Product, Stock, and Order Lifecycle", "quality_profile": "showcase", "viewBox": [1080, 720]},
  "lanes": [
    {"id": "main", "label": "Commerce lifecycle"},
    {"id": "inventory", "label": "Inventory conditions"},
    {"id": "recovery", "label": "Recovery paths"},
    {"id": "terminal", "label": "Terminal states"}
  ],
  "states": [
    {"id": "draft", "type": "start", "label": "Draft Product", "sublabel": "details incomplete", "lane": "main", "col": 0, "step": "01"},
    {"id": "active", "type": "active", "label": "Active Product", "sublabel": "publicly sellable", "lane": "main", "col": 1, "step": "02"},
    {"id": "stocked", "type": "active", "label": "In Stock", "sublabel": "available quantity", "lane": "main", "col": 2, "step": "03"},
    {"id": "reserved", "type": "decision", "label": "Reserved", "sublabel": "checkout hold", "lane": "main", "col": 3, "step": "04"},
    {"id": "completed", "type": "success", "label": "Completed", "sublabel": "stock committed", "lane": "main", "col": 4, "step": "05"},
    {"id": "out_of_stock", "type": "failure", "label": "Out of Stock", "sublabel": "await receipt", "lane": "inventory", "col": 0},
    {"id": "released", "type": "failure", "label": "Reservation Released", "sublabel": "cancelled or expired", "lane": "recovery", "col": 1},
    {"id": "archived", "type": "failure", "label": "Product Archived", "sublabel": "hidden from shop", "lane": "terminal", "col": 0}
  ],
  "transitions": [
    {"id": "stocked_empty", "from": "stocked", "to": "out_of_stock", "variant": "security", "route": "drop"},
    {"id": "empty_stocked", "from": "out_of_stock", "to": "stocked", "variant": "emphasis"},
    {"id": "reserved_release", "from": "reserved", "to": "released", "variant": "security", "route": "drop"},
    {"id": "released_stocked", "from": "released", "to": "stocked", "label": "release quantity", "variant": "emphasis"}
  ],
  "cards": [
    {"dot": "emerald", "title": "Happy Path", "items": ["Draft becomes active after category, brand policy, attributes, and variants validate", "Checkout reserves stock before an order can complete"]},
    {"dot": "rose", "title": "Recovery", "items": ["Cancelled or expired reservations restore availability", "Archived products remain stored but disappear from public selling paths"]}
  ]
}
