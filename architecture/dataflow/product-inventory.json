{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {"title": "Product and Inventory Data Flow", "quality_profile": "showcase", "viewBox": [1080, 760]},
  "stages": [{"label": "Define"}, {"label": "Build"}, {"label": "Stock"}, {"label": "Sell"}, {"label": "Fulfill"}],
  "nodes": [
    {"id": "catalog", "type": "backend", "label": "Catalog", "sublabel": "taxonomy", "stage": 0, "row": 1},
    {"id": "rbac", "type": "security", "label": "RBAC", "sublabel": "authorize admin writes", "stage": 0, "row": 3},
    {"id": "product", "type": "backend", "label": "Product", "sublabel": "details and attributes", "stage": 1, "row": 0},
    {"id": "variant", "type": "backend", "label": "Variants", "sublabel": "SKU, price, options", "stage": 1, "row": 2},
    {"id": "inventory", "type": "database", "label": "InventoryStock", "sublabel": "available qty", "stage": 2, "row": 1},
    {"id": "movement", "type": "database", "label": "Movements", "sublabel": "receive, adjust, sale", "stage": 2, "row": 3},
    {"id": "shop", "type": "frontend", "label": "Public Shop", "sublabel": "cards, filters, detail", "stage": 3, "row": 0},
    {"id": "cart", "type": "frontend", "label": "Cart", "sublabel": "variant and quantity", "stage": 3, "row": 2},
    {"id": "order", "type": "database", "label": "Order", "sublabel": "line items and totals", "stage": 4, "row": 1},
    {"id": "reservation", "type": "database", "label": "Reservation", "sublabel": "stock hold", "stage": 4, "row": 3}
  ],
  "flows": [
    {"id": "catalog_product", "from": "catalog", "to": "product", "label": "category + template", "classification": "catalog metadata", "variant": "emphasis"},
    {"id": "rbac_catalog", "from": "rbac", "to": "catalog", "label": "authorized mutation", "classification": "permission decision", "variant": "security", "labelAt": [100, 542]},
    {"id": "product_variant", "from": "product", "to": "variant", "label": "variant definitions", "classification": "merchandise", "labelAt": [315, 200]},
    {"id": "variant_stock", "from": "variant", "to": "inventory", "label": "SKU stock key", "classification": "inventory"},
    {"id": "inventory_movement", "from": "inventory", "to": "movement", "label": "quantity change", "classification": "audit trail", "variant": "dashed", "labelAt": [530, 314]},
    {"id": "product_shop", "from": "product", "to": "shop", "label": "active product data", "classification": "public catalog", "variant": "emphasis", "route": "straight"},
    {"id": "inventory_shop", "from": "inventory", "to": "shop", "label": "availability", "classification": "computed stock"},
    {"id": "shop_cart", "from": "shop", "to": "cart", "label": "selected variant", "classification": "client state", "labelAt": [745, 428]},
    {"id": "cart_order", "from": "cart", "to": "order", "label": "checkout lines", "classification": "purchase"},
    {"id": "order_reservation", "from": "order", "to": "reservation", "label": "reserve requested qty", "classification": "transaction", "variant": "emphasis", "labelAt": [960, 314]}
  ],
  "cards": [
    {"dot": "emerald", "title": "Single Model", "items": ["Admin catalog and public shop read the same ecommerce tables", "Variants connect product choices to price and inventory"]},
    {"dot": "orange", "title": "Inventory Accounting", "items": ["Stock stores current quantities", "Movements explain changes; reservations protect checkout quantities"]}
  ]
}
