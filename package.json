{
  "name": "ts-starter",
  "author": {
    "name": "Khalid",
    "email": "khalidcode03@gmail.com",
    "url": "https://github.com/khalids01"
  },
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.3.1",
      "zod": "^4.3.6",
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.9",
      "better-auth": "^1.4.18",
      "@prisma/client": "^7.4.0",
      "@polar-sh/better-auth": "^1.8.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "start": "bun --env-file=tests/env/.env ./node_modules/.bin/turbo --env-mode=loose -F web -F server start",
    "start:production": "turbo -F web -F server start",
    "build": "bun --env-file=tests/env/.env ./node_modules/.bin/turbo --env-mode=loose build",
    "build:production": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:studio": "turbo -F @db db:studio",
    "db:generate": "turbo -F @db db:generate",
    "db:reset": "turbo -F @db db:reset",
    "db:migrate": "turbo -F @db db:migrate",
    "db:seed": "turbo -F @db db:seed",
    "db:seed:rbac": "turbo -F @db db:seed:rbac",
    "db:seed:ecommerce": "bun run --cwd packages/db db:seed:ecommerce",
    "make-owner": "bun run --cwd packages/db db:make-owner",
    "test:e2e:guard": "bun --env-file=tests/env/.env tests/setup/assert-test-environment.ts",
    "test:e2e:provision": "bun --env-file=tests/env/.env tests/setup/provision-users.ts",
    "test:e2e:reset": "bun --env-file=tests/env/.env tests/setup/reset-test-state.ts",
    "test:e2e:setup": "bun --env-file=tests/env/.env ./node_modules/.bin/playwright test --project=setup",
    "test:e2e:integration": "bun --env-file=tests/env/.env test tests/integration/ecommerce.real-db.test.ts",
    "test:e2e": "bun --env-file=tests/env/.env ./node_modules/.bin/playwright test",
    "test:e2e:auth": "bun --env-file=tests/env/.env ./node_modules/.bin/playwright test --project=chromium --grep @auth",
    "e2e": "DISPLAY=${DISPLAY:-:1} E2E_MANAGED_SERVER=true bun --env-file=tests/env/.env ./node_modules/.bin/playwright test",
    "view-archi": "bun scripts/serve-architecture.ts"
  },
  "dependencies": {
    "@env": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "dotenv": "^17.3.1",
    "nodemailer": "^8.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@config": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.9",
    "turbo": "^2.9.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.3"
}
