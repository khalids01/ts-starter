model ShippingRate {
  id             String   @id @default(cuid())
  code           String   @unique
  label          String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("BDT")
  freeOverAmount Decimal? @db.Decimal(12, 2)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  tier           String   @default("standard")
  destinationRules Json?
  minimumOrderAmount Decimal? @db.Decimal(12, 2)
  maximumOrderAmount Decimal? @db.Decimal(12, 2)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]
  courierServices CourierServiceMethod[]

  @@index([isActive])
  @@index([isDefault])
  @@index([currency])
  @@index([sortOrder])
  @@index([archivedAt, sortOrder])
  @@map("shipping_rate")
}
