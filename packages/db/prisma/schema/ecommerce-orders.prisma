enum OrderStatus {
  pending
  confirmed
  processing
  completed
  cancelled
}

enum PaymentStatus {
  unpaid
  authorized
  paid
  partially_refunded
  refunded
  failed
}

enum DeliveryStatus {
  unfulfilled
  preparing
  ready_to_ship
  shipped
  out_for_delivery
  delivered
  returned
  failed
}

enum OrderInventoryStatus {
  reserved
  committed
  released
  restocked
}

enum PaymentMethod {
  cash_on_delivery
  manual_bank
  manual_mobile
  online_gateway
}

enum OrderStatusEventType {
  order
  payment
  delivery
}

enum OrderAddressType {
  shipping
  billing
}

model Order {
  id                          String               @id @default(cuid())
  orderNumber                 String               @unique
  checkoutKey                 String?              @unique
  userId                      String?
  user                        User?                @relation("UserOrders", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customerName                String
  customerEmail               String
  customerPhone               String?
  subtotalAmount              Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount              Decimal              @default(0) @db.Decimal(12, 2)
  discountCodeId              String?
  discountCode                DiscountCode?        @relation(fields: [discountCodeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  discountCodeSnapshot        String?
  discountDescriptionSnapshot String?
  discountTypeSnapshot        DiscountType?
  discountValueSnapshot       Decimal?             @db.Decimal(12, 2)
  taxAmount                   Decimal              @default(0) @db.Decimal(12, 2)
  shippingAmount              Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount                 Decimal              @default(0) @db.Decimal(12, 2)
  currency                    String               @default("BDT")
  paymentMethod               PaymentMethod        @default(cash_on_delivery)
  orderStatus                 OrderStatus          @default(pending)
  paymentStatus               PaymentStatus        @default(unpaid)
  deliveryStatus              DeliveryStatus       @default(unfulfilled)
  inventoryStatus             OrderInventoryStatus @default(reserved)
  stockReservedUntil          DateTime?
  stockCommittedAt            DateTime?
  stockReleasedAt             DateTime?
  shippingRateId              String?
  shippingRate                ShippingRate?        @relation(fields: [shippingRateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  shippingMethodCode          String?
  shippingMethodLabel         String?
  carrier                     String?
  trackingNumber              String?
  fulfillmentNote             String?              @db.Text
  shippedAt                   DateTime?
  deliveredAt                 DateTime?
  customerNotes               String?              @db.Text
  adminNotes                  String?              @db.Text
  placedAt                    DateTime             @default(now())
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  addresses          OrderAddress[]
  lineItems          OrderLineItem[]
  statusEvents       OrderStatusEvent[]
  refunds            OrderRefund[]
  discountRedemption DiscountRedemption?

  @@index([userId])
  @@index([customerEmail])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([inventoryStatus])
  @@index([paymentMethod])
  @@index([discountCodeId])
  @@index([shippingRateId])
  @@index([placedAt])
  @@map("order")
}

model OrderRefund {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  amount           Decimal  @db.Decimal(12, 2)
  currency         String
  reason           String
  note             String?  @db.Text
  restockInventory Boolean  @default(false)
  actorUserId      String?
  actorUser        User?    @relation("OrderRefundActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt        DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([actorUserId])
  @@map("order_refund")
}

model OrderAddress {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type       OrderAddressType
  fullName   String
  email      String?
  phone      String?
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  notes      String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([orderId, type])
  @@index([type])
  @@map("order_address")
}

model OrderLineItem {
  id                 String          @id @default(cuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId          String?
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  productName        String
  variantName        String?
  sku                String?
  imageUrl           String?
  attributesSnapshot Json?
  quantity           Int
  unitPrice          Decimal         @db.Decimal(12, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  subtotalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_line_item")
}

model OrderStatusEvent {
  id            String               @id @default(cuid())
  orderId       String
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type          OrderStatusEventType
  previousValue String?
  newValue      String
  note          String?              @db.Text
  metadata      Json?
  actorUserId   String?
  actorUser     User?                @relation("OrderStatusEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt     DateTime             @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@index([actorUserId])
  @@map("order_status_event")
}
