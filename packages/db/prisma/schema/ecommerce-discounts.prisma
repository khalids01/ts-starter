enum DiscountType {
  percentage
  fixed_amount
}

model DiscountCode {
  id                    String       @id @default(cuid())
  code                  String       @unique
  description           String?
  type                  DiscountType
  value                 Decimal      @db.Decimal(12, 2)
  currency              String?
  isActive              Boolean      @default(true)
  startsAt              DateTime?
  endsAt                DateTime?
  minimumOrderAmount    Decimal?     @db.Decimal(12, 2)
  totalUsageLimit       Int?
  perCustomerUsageLimit Int?
  usageCount            Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  orders      Order[]
  redemptions DiscountRedemption[]

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@map("discount_code")
}

model DiscountRedemption {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerKey    String
  amount         Decimal      @db.Decimal(12, 2)
  currency       String
  createdAt      DateTime     @default(now())

  @@index([discountCodeId, createdAt])
  @@index([discountCodeId, customerKey])
  @@map("discount_redemption")
}
