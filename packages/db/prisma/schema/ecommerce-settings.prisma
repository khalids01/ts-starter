model StoreSettings {
  id                         String   @id @default("default")
  storeName                  String
  supportEmail               String?
  supportPhone               String?
  defaultCurrency            String   @default("BDT")
  orderNumberPrefix          String   @default("ORD")
  reservationDurationMinutes Int      @default(30)
  checkoutEnabled            Boolean  @default(true)
  checkoutNotice             String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("store_settings")
}
