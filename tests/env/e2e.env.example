# Copy to tests/env/e2e.env for local-only E2E work. Never use production credentials here.
NODE_ENV=test
DATABASE_URL=postgresql://e2e:e2e-local-only@127.0.0.1:5433/ts_starter_e2e
REDIS_URL=redis://127.0.0.1:6380
REDIS_KEY_PREFIX=ts-starter:e2e:
BETTER_AUTH_SECRET=e2e-only-better-auth-secret-change-me-2026
BETTER_AUTH_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:3101
VITE_SERVER_URL=http://localhost:3100
VITE_PORT=3101
PORT=3100
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL=e2e-mailer@northstar.example.test
EMAIL_FROM=Northstar E2E
ENABLE_POLAR=false
VITE_ENABLE_POLAR=false
OWNER_SETUP_CHECK=false
VITE_OWNER_SETUP_CHECK=false
GITHUB_CLIENT_ID=e2e-github-client-id
GITHUB_CLIENT_SECRET=e2e-github-client-secret
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret
DISCORD_CLIENT_ID=e2e-discord-client-id
DISCORD_CLIENT_SECRET=e2e-discord-client-secret
E2E_MAILPIT_URL=http://127.0.0.1:8025
