# Copy to tests/env/.env for local-only E2E work. Never use production credentials here.
# All non-secret E2E defaults live in packages/config/src/e2e.config.ts.
E2E_MODE=true
NODE_ENV=test
DATABASE_URL=postgresql://e2e:e2e-local-only@127.0.0.1:5433/ts_starter_e2e
REDIS_URL=redis://127.0.0.1:6380
BETTER_AUTH_SECRET=e2e-only-better-auth-secret-change-me-2026
